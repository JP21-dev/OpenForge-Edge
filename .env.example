# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
CHROMA_HOST_PORT=8001
MONGO_HOST_PORT=27017

# Frontend (rebuild the frontend image after changing)
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM (Ollama)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.2
LLM_KEEP_ALIVE=30m

# LLM (AMD Lemonade, OpenAI-compatible; move BACKEND_PORT off 8000 when using this)
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://host.docker.internal:8000/api/v1
# LLM_MODEL=Llama-3.2-3B-Instruct-Hybrid

# ChromaDB
CHROMA_VERSION=1.5.9
CHROMA_COLLECTION=repair_manuals

# MongoDB
MONGO_VERSION=8.0
MONGO_ROOT_USER=openforge
MONGO_ROOT_PASSWORD=change-me
MONGO_DB=openforge
