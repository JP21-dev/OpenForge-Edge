# OpenForge Edge on AMD Lemonade
# Copy to .env, then: docker compose up -d --build && docker compose exec backend python ingest.py --reset

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
CHROMA_HOST_PORT=8001
MONGO_HOST_PORT=27017

# Frontend (rebuild the frontend image after changing)
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM (Lemonade, OpenAI-compatible). Current Lemonade releases listen on 13305; older ones used 8000.
LLM_PROVIDER=lemonade
LLM_BASE_URL=http://host.docker.internal:13305/api/v1
LLM_API_KEY=lemonade
LLM_TEMPERATURE=0.2
LLM_ENABLE_THINKING=false
LLM_JSON_MODE=false

# Pick one chat model:
#   Ryzen AI 300 series (NPU + iGPU, Windows):  Qwen2.5-7B-Instruct-Hybrid
#   Ryzen AI 300 series (NPU only, Windows):    Qwen2.5-7B-Instruct-NPU
#   Radeon / any Vulkan or ROCm GPU:            Qwen3-8B-GGUF
#   Smaller GPUs or CPU:                        Qwen3-4B-Instruct-2507-GGUF
LLM_MODEL=Qwen2.5-7B-Instruct-Hybrid

# Embeddings (Lemonade llama.cpp embedding model)
EMBED_PROVIDER=lemonade
EMBED_BASE_URL=http://host.docker.internal:13305/api/v1
EMBED_API_KEY=lemonade
EMBED_MODEL=nomic-embed-text-v1-GGUF
RAG_TOP_K=4
RAG_MIN_SCORE=0.6

# ChromaDB
CHROMA_VERSION=1.5.9
CHROMA_COLLECTION=repair_manuals

# MongoDB
MONGO_VERSION=8.0
MONGO_ROOT_USER=openforge
MONGO_ROOT_PASSWORD=change-me
MONGO_DB=openforge
