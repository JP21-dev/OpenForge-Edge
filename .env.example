# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
CHROMA_HOST_PORT=8001
MONGO_HOST_PORT=27017

# Frontend. Leave NEXT_PUBLIC_API_URL unset: the browser calls /api on the Bench UI's own
# address, which proxies to the backend. Set it only to point browsers at another backend.
# NEXT_PUBLIC_API_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM (Ollama)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.2
LLM_KEEP_ALIVE=30m
LLM_NUM_CTX=8192

# Deep thinking (the Deep button in the chat): a stronger, slower model for hard problems.
# DEEP_THINKING=true also lets it reason before answering: much slower, worth it only on bigger models.
DEEP_MODEL=qwen3:8b
DEEP_THINKING=false

# Vision model, used only in Ingest mode to read schematic pages and photos
VISION_MODEL=qwen3-vl:4b-instruct
VISION_BASE_URL=http://host.docker.internal:11434
VISION_MAX_SIDE=1600
UPLOAD_MAX_MB=100

# Bench data
PATTERN_MIN_REPAIRS=3
PATTERN_SIMILARITY=0.78
COVERAGE_MIN_REFERENCES=10
COVERAGE_MIN_REPAIRS=5

# AMD Lemonade: copy .env.lemonade.example to .env instead (see README)

# Knowledge base (embeddings via Ollama)
EMBED_BASE_URL=http://host.docker.internal:11434
EMBED_MODEL=nomic-embed-text
RAG_TOP_K=4
RAG_MIN_SCORE=0.6

# ChromaDB
CHROMA_VERSION=1.5.9
CHROMA_COLLECTION=repair_manuals

# MongoDB
MONGO_VERSION=8.0
MONGO_ROOT_USER=openforge
MONGO_ROOT_PASSWORD=change-me
MONGO_DB=openforge
